#!/usr/bin/env python3
"""模拟 kubectl，仅用于本地演示 / 测试。

pod 用目录 $MOCK_ROOT/pods/<pod>/ 表示；exec 时命令里的 /opt/agent、/var/log/agent、/tmp
会被映射到 pod 目录下，cp 同理。支持：
  kubectl get pods -n NS [--no-headers] [-o ...]
  kubectl exec -n NS POD -- sh -c CMD
  kubectl cp SRC NS/POD:DST
"""
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("MOCK_ROOT", Path(__file__).resolve().parents[2] / "data" / "mock"))
PODS = ROOT / "pods"
PREFIX_RE = re.compile(r"(?<![\w/.])(/opt/agent|/var/log/agent|/tmp)(?=/|\s|'|\"|$)")


def pod_dir(pod: str) -> Path:
    d = PODS / pod
    if not d.is_dir():
        sys.stderr.write(f'Error from server (NotFound): pods "{pod}" not found\n')
        sys.exit(1)
    return d


def remap(text: str, pod: str) -> str:
    base = str(pod_dir(pod))
    return PREFIX_RE.sub(lambda m: base + m.group(1), text)


def main(argv):
    if not argv:
        print("mock kubectl")
        return 0
    if argv[0] == "get" and len(argv) > 1 and argv[1] in ("pods", "pod", "po"):
        no_headers = "--no-headers" in argv
        if not no_headers:
            print("NAME STATUS")
        for d in sorted(PODS.iterdir()) if PODS.is_dir() else []:
            if d.is_dir():
                status = (d / ".status").read_text().strip() if (d / ".status").exists() else "Running"
                print(f"{d.name} {status}")
        return 0
    if argv[0] == "exec":
        args = argv[1:]
        sep = args.index("--")
        pre, cmd = args[:sep], args[sep + 1:]
        pod = [a for i, a in enumerate(pre) if not a.startswith("-") and (i == 0 or pre[i - 1] not in ("-n", "--namespace", "-c"))][0]
        pod_dir(pod)
        if cmd[:2] == ["sh", "-c"]:
            full = ["sh", "-c", remap(cmd[2], pod)]
        else:
            full = [remap(c, pod) for c in cmd]
        # 输出里的本地目录映射回 pod 内路径（例如 find 的结果）
        p = subprocess.run(full, capture_output=True)
        base = str(pod_dir(pod)).encode()
        sys.stdout.buffer.write(p.stdout.replace(base, b""))
        sys.stderr.buffer.write(p.stderr.replace(base, b""))
        return p.returncode
    if argv[0] == "cp":
        src, dst = argv[1], argv[2]
        if ":" in dst:
            nspod, path = dst.split(":", 1)
            pod = nspod.split("/")[-1]
            target = Path(remap(path, pod))
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(src, target)
            return 0
        nspod, path = src.split(":", 1)
        pod = nspod.split("/")[-1]
        shutil.copy(remap(path, pod), dst)
        return 0
    if argv[0] == "version":
        print("Client Version: mock")
        return 0
    sys.stderr.write(f"mock kubectl: unsupported {argv}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
